<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="generator_engine">
  <description>Drupal coding standards for the Generator Engine project.</description>

  <file>.</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- Third-party and binary assets are not ours to reformat. -->
  <exclude-pattern>./js/*</exclude-pattern>
  <exclude-pattern>./assets/*</exclude-pattern>
  <exclude-pattern>./vendor/*</exclude-pattern>

  <rule ref="Drupal">
    <!--
      This sniff requires a trailing comma after the last parameter of a
      multi-line function declaration, which is PHP 8.0 syntax. This project
      supports Drupal ^9.4, which still runs on PHP 7.4, where that syntax is
      a parse error. Drop this exclusion when the core requirement is raised
      to ^10.3 || ^11.
    -->
    <exclude name="Drupal.Functions.MultiLineFunctionDeclaration.MissingTrailingComma"/>
  </rule>

  <rule ref="DrupalPractice"/>
</ruleset>
